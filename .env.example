# ---------------------------------------------------------------------------
# twquant — environment template
#
#   cp .env.example .env
#
# Then replace every value marked CHANGE-ME. `.env` is gitignored and must
# never be committed. Settings validation refuses to boot staging/production
# with placeholder secrets, so a forgotten value fails loudly at startup rather
# than silently shipping a known password.
#
# Generate a secret:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

# --------------------------------------------------------------- application
APP_NAME=twquant
APP_ENV=local                 # local | test | staging | production
APP_VERSION=0.1.0
DEBUG=false
TIMEZONE=Asia/Taipei

# ---------------------------------------------------------------- database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=twquant
POSTGRES_PASSWORD=CHANGE-ME-postgres-password
POSTGRES_DB=twquant
POSTGRES_TEST_DB=twquant_test

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Extension requirements. Both must stay true in staging/production — the
# config validator rejects false there. Set REQUIRE_TIMESCALEDB=false only when
# developing against a plain Postgres install without the extension.
REQUIRE_TIMESCALEDB=true
REQUIRE_PGVECTOR=true

# ------------------------------------------------------------------- redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_RESULT_DB=2
REDIS_MAXMEMORY=512mb

# -------------------------------------------------------------------- auth
# Minimum 32 characters. Placeholder values are rejected outside local/test.
JWT_SECRET=CHANGE-ME-generate-a-64-character-random-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# -------------------------------------------------------------------- cors
CORS_ORIGINS=["http://localhost:3000"]

# -------------------------------------------------------------------- data
# Whether mock/demo data may be served at all. MUST be false in production:
# fabricated market data must never be presentable as real.
ALLOW_MOCK_DATA=true

# live   — fetch from the exchange. The only value permitted in production.
# replay — serve recorded responses through the production parsers. Genuine
#          market data, replayed transport; every ingestion row is stamped
#          REPLAY so no number can claim an HTTP request that never happened.
PROVIDER_MODE=live

# --------------------------------------------------------------------- llm
# The LLM is optional by design. With ENABLE_LLM=false the platform's core
# (market data, quant, database, API, backtesting) runs unchanged.
ENABLE_LLM=false
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------ worker
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_TTL_SECONDS=120

# ------------------------------------------------------------ observability
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json | console
HEALTH_TIMEOUT_SECONDS=5.0

# ------------------------------------------------------------------- seed
# Used once by `make seed`. Omit SEED_ADMIN_PASSWORD in local/test and one will
# be generated and printed.
SEED_ADMIN_EMAIL=admin@twquant.dev
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------- frontend
BACKEND_URL=http://localhost:8000

# ------------------------------------------- object storage (profile: storage)
MINIO_ROOT_USER=twquant
MINIO_ROOT_PASSWORD=CHANGE-ME-minio-password
